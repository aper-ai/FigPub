{
  "name": "figure-workbench-development",
  "version": "0.6.2",
  "private": true,
  "description": "Figure Workbench desktop scientific workbench and optional browser composition studio",
  "scripts": {
    "lint": "oxlint web tests/*.mjs scripts/*.mjs",
    "test": "node --test tests/*.mjs tests/test_gel.cjs",
    "test:frontend": "node --test tests/*.mjs",
    "bench:frontend": "node --expose-gc scripts/benchmark_frontend.mjs",
    "build:browser": "node scripts/build_browser_studio.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "oxlint": "1.93.0"
  }
}
